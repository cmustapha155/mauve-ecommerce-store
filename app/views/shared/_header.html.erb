<%= stylesheet_link_tag "header.css" %>

<header>
  <div id = "message-bar">
    <span>Free shipping on orders over $200</span>
  </div>

  <div id = "title-bar">
    <%= link_to root_path do %>
      <div class = "title-text">
        <h1>MAUVE</h1>
        <h2>FURNISHINGS</h2>
      </div>
    <% end %>

    <div class = "search-bar">
      <%# <label for = "search">Search</label> %>
      <%# <input id = "search" type = text placeholder = "Search"> %>

      <%= form_tag search_results_path, method: "get" do %>
        <%= text_field_tag :q, params[:q], placeholder: "Search for products..." %>
        <%= select_tag :category_id, options_from_collection_for_select(Category.all, :id, :name, params[:category_id]), prompt: "All Categories" %>
        <%= submit_tag "Search" %>
      <% end%>
    </div>

    <div class = "icons">
      <% if customer_signed_in? %>
        <%= button_to "Sign_out", destroy_customer_session_path, :method => 'delete', data:{turbo: "false"}%>
        <%= link_to "Account", edit_customer_registration_path %>
      <% else %>
        <%= link_to "Sign Up", new_customer_registration_path %>
        <%= link_to "Login", new_customer_session_path %>
      <% end %>


      <%# <%= link_to "Account" %>
      <%= link_to "Cart", cart_path %>
    </div>
  </div>
</header>