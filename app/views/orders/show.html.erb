<%= stylesheet_link_tag "style.css" %>
<%= stylesheet_link_tag "checkout.css" %>
<%= render "shared/header" %>
<%= render "shared/nav" %>

<h2 style = "text-align: center;">Confirm Order Details</h2>

<div class = "container">

  <div class="summary">
    <h3>Summary</h3>

    <p>Subtotal: <%= number_to_currency(@order.subtotal) %></p>
    <p>GST/HST: <%= number_to_currency(@order.provincial_sales_tax) %></p>
    <p>GST/HST: <%= number_to_currency(@order.general_sales_tax) %></p>
    <p>Total: <%= number_to_currency(@order.total_price) %></p>

    <hr style="border-color: lightgrey">

    <p><strong>Order Number:</strong> <%= @order.id %></p>

    <p><strong>Status:</strong> <%= @order.status %></p>

    <p><strong>Customer Email:</strong> <%= @order.email %></p>

    <p>
      <strong>Shipping Address:</strong><br>
      <%= @order.address %>
      <% if @order.apartment_number.present? %> #<%= @order.apartment_number %><% end %><br>
      <%= @order.city %>, <%= @order.state %> <%= @order.zip %><br>
      <%= @order.country %>
    </p>

  </div>
</div>

<%= render "shared/footer" %>