<%= stylesheet_link_tag "style.css" %>
<%= stylesheet_link_tag "checkout.css" %>
<%= render "shared/header" %>
<%= render "shared/nav" %>

<h2 style = "text-align: center;">Checkout Details</h2>

<% if @cart_items.empty? %>
  <h3 style = "text-align: center;">Uh oh! Your cart is empty.</h3>

<% else %>
  <div class = "container">

    <% item_count = 0 %>
    <% @cart_items.each do |item| %>
      <% item_count += 1 %>
    <% end %>

    <div class="summary">
      <h3>Summary (<%= item_count %> Items)</h3>

      <p>Subtotal: <b>$<%= @total_price %></b></p>
      <p>GST/HST: --</p>
      <p>PST/RST/QST: --</p>
      <p>Order Total: --</p>

      <p><i>Proceed to calculate taxes</i></p>
    </div>


    <%= form_with url: orders_path, html: { class: "checkout-form" }, method: :post do |f| %>
      <div>
        <label for="email">Email:</label>
        <%= text_field_tag :email, @order.email, required: true %>
      </div>

      <div>
        <label for="address">Address:</label>
        <%= text_field_tag :address, @order.address, required: true %>
      </div>

      <div>
        <label for="apartment_number">Apartment/Unit:</label>
        <%= text_field_tag :apartment_number, @order.apartment_number %>
      </div>

      <div>
        <label for="city">City:</label>
        <%= text_field_tag :city, @order.city, required: true %>
      </div>

      <div>

        <%= f.label :state, "Province/Territory" %>
        <%= f.select :state, [
              "AB", "BC", "MB", "NB", "NL", "NS", "NT", "NU",
              "ON", "PE", "QC", "SK", "YT"
            ], { prompt: "Select Province/Territory" }, class: "input-field", required: true %>
      </div>

      <div>
        <label for="zip">Zip/Postal Code:</label>
        <%= text_field_tag :zip, @order.zip, required: true %>
      </div>

      <div>

        <%= f.label :country, "Country" %>
        <%= f.select :country, ["Canada"], { prompt: "Select Country" }, class: "input-field", required: true %>
      </div>

      <div>
        <%= submit_tag "Review Order", class: "button" %>
      </div>
    <% end %>

  </div>
<% end %>

<%= render "shared/footer" %>